{
  "name": "betboos365-website",
  "version": "0.1.0",
  "private": true,
  "description": "BetBoos365 website — Next.js frontend (Step 02: design system)",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:frontend": "next dev",
    "dev:backend": "cd server && npm run start:dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate --schema=./server/prisma/schema.prisma && npm run server:build",
    "server:build": "cd server && npm install --no-audit --no-fund && npx tsc -p tsconfig.build.json",
    "prisma:generate": "prisma generate --schema=./server/prisma/schema.prisma",
    "prisma:migrate:prod": "prisma migrate deploy --schema=./server/prisma/schema.prisma",
    "prisma:seed:prod": "cd server && npx ts-node prisma/seed.prod.ts",
    "staff:bootstrap": "cd server && npx ts-node prisma/bootstrap-staff.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/platform-socket.io": "^11.2.9",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.9",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "clsx": "^2.1.1",
    "framer-motion": "^14.10.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swiper": "^14.4.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "bcrypt": true
  }
}