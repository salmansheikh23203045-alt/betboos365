{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/v1/[[...slug]]/route.ts": {
      "includeFiles": "server/dist/**;server/prisma/**;node_modules/{@nestjs,@prisma,.prisma,bcrypt,reflect-metadata,class-validator,class-transformer,passport,passport-jwt,helmet,ioredis,uuid,express,tslib,rxjs,iterare,path-to-regexp,body-parser,cookie,raw-body}/**"
    }
  }
}
