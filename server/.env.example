# ======================================
# TCL11 Backend Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env to version control
# ======================================

# Application
NODE_ENV=development
PORT=3200
API_PREFIX=api/v1

# Database (PostgreSQL)
# Local dev uses a single URL; Neon production separates pooled vs direct.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tcl11?schema=public
# DIRECT_URL is only needed in production (Neon). If unset, Prisma falls
# back to DATABASE_URL for migrations, which is correct for local dev.
# DIRECT_URL=

# JWT Authentication
JWT_SECRET=CHANGE_ME_use_a_strong_random_secret_at_least_32_chars
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Sports API Provider (mock by default)
SPORTS_API_PROVIDER=mock
SPORTS_API_KEY=
SPORTS_API_BASE_URL=

# Logging
LOG_LEVEL=debug
